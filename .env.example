# Copie para `.env` e preencha. O `.env` NUNCA deve ser versionado (está no .gitignore).
#   cp .env.example .env

# --- Aplicação ---------------------------------------------------------------
APP_NAME=llm-service-core
# local | test | staging | production
ENVIRONMENT=local
DEBUG=false
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- LLM (prefixo LLM__ = grupo `llm` da configuração) --------------------------
# fake | anthropic | openai  — "fake" funciona sem chave de API
LLM__DEFAULT_PROVIDER=fake
LLM__ANTHROPIC_API_KEY=
LLM__OPENAI_API_KEY=
LLM__REQUEST_TIMEOUT_SECONDS=60
