# Copie para `.env` e preencha. O `.env` NUNCA deve ser versionado (está no .gitignore).
#   cp .env.example .env

# --- Aplicação ---------------------------------------------------------------
APP_NAME=llm-service-core
# local | test | staging | production
ENVIRONMENT=local
DEBUG=false
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- LLM (prefixo LLM__ = grupo `llm` da configuração) --------------------------
# fake | anthropic | openai  — "fake" funciona sem chave de API
LLM__DEFAULT_PROVIDER=fake
LLM__ANTHROPIC_API_KEY=
LLM__OPENAI_API_KEY=
LLM__REQUEST_TIMEOUT_SECONDS=60
LLM__MAX_OUTPUT_TOKENS=16000
LLM__MAX_RETRIES=2

# --- Anthropic -------------------------------------------------------------------
# claude-haiku-5-5 (rápido/barato) | claude-sonnet-5-5 | claude-opus-5-5 (mais capaz)
LLM__ANTHROPIC_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max — vazio usa o padrão do modelo
LLM__ANTHROPIC_EFFORT=
# true só para Opus/Sonnet/Fable (o Haiku não tem fallback de recusa)
LLM__ANTHROPIC_REFUSAL_FALLBACK=false
